# GEMINI_API_KEY: Optional. Enables Gemini AI reasoning alongside deterministic rules.
# Uses the free-tier model 'gemini-3.8-flash' (no paid billing or credit card required).
# If omitted, CodeSage AI operates 100% autonomously using the deterministic static engine.
GEMINI_API_KEY=""

# NODE_ENV: Set to "production" in production environments (e.g., on Render).
NODE_ENV="production"

# PORT: The port the HTTP server binds to (default: 3000, Render injects this dynamically).
PORT="3000"

# APP_URL: Optional. Canonical URL where the app is hosted (e.g., https://codesage-ai.onrender.com).
APP_URL=""
